# Copia este archivo como .env y completa tus datos.
# El archivo .env NO se sube a Git.

# Clave secreta de Django. Genera una propia con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave

# True solo en desarrollo
DEBUG=True

# Base de datos MySQL/MariaDB (XAMPP)
DB_NAME=votaciones_festival
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
